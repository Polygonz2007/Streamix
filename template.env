
## GENERAL ##

# Where your music is located. Seperate directories with ";". Spaces between directories are allowed.
music_path = "..."

# Used by Express.js. Set to something random.
session_secret = "..." 

# Data storage
db_path = "./data/streamix.db"
stats_path = "./data/stats.json"

# Format settings
opus_frame_size = 960 # Default
flac_frame_size = 4096  # Default